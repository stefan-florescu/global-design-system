{
  "name": "@stefan-florescu/tokens",
  "version": "0.1.0",
  "description": "Design tokens (primitive \u2192 semantic \u2192 component) built with Style Dictionary.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefan-florescu/global-design-system.git",
    "directory": "packages/tokens"
  },
  "exports": {
    ".": {
      "types": "./build/js/tokens.d.ts",
      "default": "./build/js/tokens.js"
    },
    "./css": "./build/css/variables.css",
    "./json": "./build/json/tokens.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rm -rf build .turbo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@stefan-florescu/eslint-config": "workspace:*",
    "@stefan-florescu/typescript-config": "workspace:*",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "style-dictionary": "^5.6.0",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
