{
  "name": "Carousel",
  "status": "beta",
  "description": "Cycles through a set of slides, such as images or featured content, one at a time.",
  "category": "data-display",
  "import": "import { Carousel } from \"@stefan-florescu/ui\";",
  "ariaPattern": "https://www.w3.org/WAI/ARIA/apg/patterns/carousel/",
  "client": true,
  "props": "generated",
  "variants": {
    "autoPlay": [true, false],
    "controls": [true, false],
    "indicators": [true, false],
    "transition": ["default", "fast"]
  },
  "defaults": {
    "autoPlay": false,
    "interval": 5000,
    "controls": true,
    "indicators": true,
    "transition": "default"
  },
  "tokens": [
    "color.neutral-primary-medium",
    "color.heading",
    "color.ring",
    "radius.base",
    "z.raised"
  ],
  "useWhen": ["Showcasing several images or highlights in limited space"],
  "avoidWhen": [
    "Content everyone must see: most people never get past the first slide",
    "Navigation or critical actions"
  ],
  "related": ["Card"],
  "examples": [
    "apps/storybook/registry/demos/carousel-demo.tsx",
    "apps/storybook/registry/demos/carousel-controls.tsx",
    "apps/storybook/registry/demos/carousel-indicators.tsx",
    "apps/storybook/registry/demos/carousel-animation.tsx"
  ]
}
