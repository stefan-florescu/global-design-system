{
  "name": "BottomNavigation",
  "status": "beta",
  "description": "A bar of menu items or actions fixed to the bottom of the screen, for mobile and app-like layouts.",
  "category": "navigation",
  "import": "import { BottomNavigation, BottomNavigationItem } from \"@stefan-florescu/ui\";",
  "ariaPattern": "https://www.w3.org/WAI/ARIA/apg/patterns/landmarks/examples/navigation.html",
  "client": false,
  "props": "generated",
  "parts": ["BottomNavigation", "BottomNavigationItem"],
  "variants": {
    "position": ["fixed", "sticky", "static"],
    "floating": [true, false],
    "bordered": [true, false]
  },
  "defaults": {
    "position": "fixed",
    "floating": false,
    "bordered": false
  },
  "tokens": [
    "color.neutral-primary-soft",
    "color.default",
    "color.body",
    "color.neutral-secondary-medium",
    "color.fg-brand",
    "color.ring",
    "z.fixed",
    "radius.full",
    "text.sm",
    "font.medium"
  ],
  "useWhen": ["Three to five top-level destinations on small screens"],
  "avoidWhen": ["Desktop layouts: use a header or sidebar", "More than five destinations"],
  "related": ["Breadcrumb", "Button"],
  "examples": [
    "apps/storybook/registry/demos/bottom-navigation-demo.tsx",
    "apps/storybook/registry/demos/bottom-navigation-bordered.tsx",
    "apps/storybook/registry/demos/bottom-navigation-app-bar.tsx",
    "apps/storybook/registry/demos/bottom-navigation-pagination.tsx",
    "apps/storybook/registry/demos/bottom-navigation-button-group.tsx",
    "apps/storybook/registry/demos/bottom-navigation-card.tsx"
  ]
}
