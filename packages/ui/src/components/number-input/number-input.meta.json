  "tokens": [
    "color.input",
    "color.background",
    "color.foreground",
    "color.muted",
    "color.muted-foreground",
    "color.ring",
    "color.destructive",
    "color.success",
    "radius.lg"
  ],
  "useWhen": ["Quantities and other small numbers"],
  "avoidWhen": [],
  "related": ["Label", "HelperText"],
  "docs": "apps/storybook/app/(docs)/forms/number-input/page.mdx"
