{
  "name": "NumberInput",
  "status": "beta",
  "description": "Flowbite's number input: a number field with optional control buttons (stepper), a round-button counter and a caption.",
  "category": "forms",
  "import": "import { NumberInput } from \"@stefan-florescu/ui\";",
  "ariaPattern": "https://www.w3.org/WAI/ARIA/apg/patterns/spinbutton/",
  "client": true,
  "props": "generated",
  "variants": {
    "size": ["sm", "md", "lg", "xl"],
    "variant": ["default", "counter"],
    "stepper": [true, false]
  },
  "tokens": [
    "color.neutral-secondary-medium",
    "color.input",
    "color.heading",
    "color.body",
    "color.brand",
    "color.danger",
    "color.danger-soft",
    "color.fg-danger-strong",
    "color.success",
    "color.success-soft",
    "color.fg-success-strong",
    "color.fg-disabled",
    "radius.base",
    "shadow.xs",
    "color.neutral-tertiary-medium",
    "color.neutral-tertiary",
    "color.default-medium",
    "color.body-subtle",
    "color.ring"
  ],
  "useWhen": ["Quantities and other small numbers"],
  "avoidWhen": [],
  "related": ["Input", "Label", "HelperText", "Button"],
  "docs": "apps/storybook/app/(docs)/forms/number-input/page.mdx",
  "defaults": {
    "size": "md",
    "variant": "default",
    "step": 1
  }
}
