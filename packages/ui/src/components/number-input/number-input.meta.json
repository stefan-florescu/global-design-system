{
  "name": "NumberInput",
  "status": "beta",
  "description": "A number field with optional \u2212 and + stepper buttons.",
  "category": "forms",
  "import": "import { NumberInput } from \"@stefan-florescu/ui\";",
  "ariaPattern": "https://www.w3.org/WAI/ARIA/apg/patterns/spinbutton/",
  "client": true,
  "props": "generated",
  "variants": {
    "size": ["sm", "md", "lg"],
    "stepper": [true, false]
