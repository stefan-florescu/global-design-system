{
  "name": "Banner",
  "status": "beta",
  "description": "Use a banner to show a marketing message, an announcement or a notice, pinned to the top or bottom of the page.",
  "category": "feedback",
  "import": "import { Banner } from \"@stefan-florescu/ui\";",
  "ariaPattern": "https://www.w3.org/WAI/ARIA/apg/practices/landmark-regions/",
  "client": true,
  "props": "generated",
  "variants": {
    "position": ["top", "bottom", "static"],
    "floating": [true, false],
    "dismissible": [true, false]
  },
  "defaults": {
    "position": "top",
    "floating": false
  },
  "tokens": [
    "color.neutral-primary-soft",
    "color.neutral-tertiary",
    "color.default",
    "color.body",
    "color.heading",
    "color.ring",
    "z.fixed",
    "radius.base",
    "radius.sm",
    "shadow.xs",
    "text.sm"
  ],
  "useWhen": [
    "Announcing something that affects the whole site",
    "A dismissible call to action or notice"
  ],
  "avoidWhen": ["Feedback about the current task: use Alert"],
  "related": ["Alert"],
  "examples": [
    "apps/storybook/registry/demos/banner-demo.tsx",
    "apps/storybook/registry/demos/banner-bottom.tsx",
    "apps/storybook/registry/demos/banner-cta.tsx",
    "apps/storybook/registry/demos/banner-newsletter.tsx",
    "apps/storybook/registry/demos/banner-informational.tsx"
  ]
}
