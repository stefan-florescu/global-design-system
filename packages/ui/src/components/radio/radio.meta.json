{
  "name": "Radio",
  "status": "beta",
  "description": "Flowbite's radio: a native radio with label, helper text, bordered card, list-group row and selectable-card layouts.",
  "category": "forms",
  "import": "import { Fieldset, Radio } from \"@stefan-florescu/ui\";",
  "ariaPattern": "https://www.w3.org/WAI/ARIA/apg/patterns/radio/",
  "client": false,
  "props": "generated",
  "variants": {
    "variant": ["default", "bordered", "list", "card"],
    "invalid": [true, false]
  },
  "tokens": [
    "color.neutral-secondary-medium",
    "color.input",
    "color.brand",
    "color.brand-foreground",
    "color.brand-subtle",
    "color.brand-softer",
    "color.fg-brand-strong",
    "color.neutral-primary-soft",
    "color.default",
    "color.heading",
    "color.body",
    "color.fg-disabled",
    "color.danger",
    "color.ring",
    "radius.full",
    "radius.base",
    "shadow.xs",
    "color.light-medium"
  ],
  "useWhen": ["Choosing exactly one of two to six options"],
  "avoidWhen": [],
  "related": ["Label", "HelperText"],
  "docs": "apps/storybook/app/(docs)/forms/radio/page.mdx"
}
