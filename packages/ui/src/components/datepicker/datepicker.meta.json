{
  "name": "Datepicker",
  "status": "beta",
  "description": "A datepicker: a text field with a calendar icon that opens a calendar to pick a day (Datepicker) or a range (DateRangePicker); Calendar shows the calendar inline. Dates can also be typed in a format.",
  "category": "forms",
  "import": "import { Calendar, DateRangePicker, Datepicker } from \"@stefan-florescu/ui\";",
  "ariaPattern": "https://www.w3.org/WAI/ARIA/apg/patterns/combobox/examples/combobox-datepicker/",
  "client": true,
  "props": "generated",
  "parts": ["Datepicker", "DateRangePicker", "Calendar"],
  "variants": {
    "mode": ["single", "range"],
    "orientation": ["bottom left", "bottom right", "top left", "top right"],
    "autoHide": [true, false],
    "showButtons": [true, false]
  },
  "defaults": {
    "mode": "single",
    "weekStartsOn": 0,
    "autoHide": false,
    "showButtons": false,
    "orientation": "bottom left",
    "format": "mm/dd/yyyy",
    "label": "Date",
    "placeholder": "Select date"
  },
  "tokens": [
    "color.neutral-primary-medium",
    "color.default-medium",
    "color.heading",
    "color.body",
    "color.body-subtle",
    "color.fg-disabled",
    "color.neutral-tertiary-medium",
    "color.neutral-tertiary",
    "color.brand",
    "color.brand-strong",
    "color.brand-medium",
    "color.brand-foreground",
    "color.neutral-secondary-medium",
    "color.input",
    "color.ring",
    "radius.base",
    "z.popover"
  ],
  "useWhen": [
    "Choosing a day close to today, where the weekday matters",
    "Choosing a range of days, such as a stay"
  ],
  "avoidWhen": [
    "Dates far in the past, such as a birth date: use separate day, month and year fields"
  ],
  "related": ["Input", "Timepicker", "Button"],
  "examples": [
    "apps/storybook/registry/demos/datepicker-demo.tsx",
    "apps/storybook/registry/demos/datepicker-inline.tsx",
    "apps/storybook/registry/demos/datepicker-range.tsx",
    "apps/storybook/registry/demos/datepicker-autohide.tsx",
    "apps/storybook/registry/demos/datepicker-buttons.tsx",
    "apps/storybook/registry/demos/datepicker-format.tsx",
    "apps/storybook/registry/demos/datepicker-min-max.tsx",
    "apps/storybook/registry/demos/datepicker-orientation.tsx",
    "apps/storybook/registry/demos/datepicker-title.tsx",
    "apps/storybook/registry/demos/datepicker-week-start.tsx",
    "apps/storybook/registry/demos/datepicker-disabled-days.tsx",
    "apps/storybook/registry/demos/datepicker-timepicker.tsx"
  ]
}
