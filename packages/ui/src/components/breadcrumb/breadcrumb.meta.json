{
  "name": "Breadcrumb",
  "status": "beta",
  "description": "Shows where the current page sits in the site hierarchy, with links back to each level.",
  "category": "navigation",
  "import": "import { Breadcrumb, BreadcrumbItem } from \"@stefan-florescu/ui\";",
  "ariaPattern": "https://www.w3.org/WAI/ARIA/apg/patterns/breadcrumb/",
  "client": false,
  "props": "generated",
  "parts": ["Breadcrumb", "BreadcrumbItem"],
  "variants": {
    "variant": ["default", "solid"]
  },
  "defaults": {
    "variant": "default"
  },
  "tokens": [
    "color.body",
    "color.fg-brand",
    "color.body-subtle",
    "color.neutral-secondary-medium",
    "color.default-medium",
    "color.ring",
    "radius.base",
    "text.sm",
    "font.medium"
  ],
  "useWhen": ["Pages nested two or more levels deep"],
  "avoidWhen": ["Flat sites with one level", "Showing steps of a process: use a stepper"],
  "related": ["BottomNavigation"],
  "examples": [
    "apps/storybook/registry/demos/breadcrumb-demo.tsx",
    "apps/storybook/registry/demos/breadcrumb-solid.tsx",
    "apps/storybook/registry/demos/breadcrumb-navigation.tsx"
  ]
}
