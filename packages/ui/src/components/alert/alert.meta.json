{
  "name": "Alert",
  "status": "beta",
  "description": "Show contextual messages to your users, such as information, success, a warning or an error.",
  "category": "feedback",
  "import": "import { Alert, AlertDescription, AlertTitle } from \"@stefan-florescu/ui\";",
  "ariaPattern": "https://www.w3.org/WAI/ARIA/apg/patterns/alert/",
  "client": true,
  "props": "generated",
  "parts": ["Alert", "AlertTitle", "AlertDescription"],
  "variants": {
    "variant": ["brand", "danger", "success", "warning", "dark"],
    "bordered": [true, false],
    "accentBorder": [true, false],
    "dismissible": [true, false]
  },
  "defaults": {
    "variant": "brand"
  },
  "tokens": [
    "color.brand-softer",
    "color.brand-soft",
    "color.brand-medium",
    "color.brand-subtle",
    "color.fg-brand-strong",
    "color.danger-soft",
    "color.danger-medium",
    "color.danger-subtle",
    "color.fg-danger-strong",
    "color.success-soft",
    "color.success-medium",
    "color.success-subtle",
    "color.fg-success-strong",
    "color.warning-soft",
    "color.warning-medium",
    "color.warning-subtle",
    "color.fg-warning",
    "color.neutral-secondary-medium",
    "color.neutral-tertiary",
    "color.neutral-tertiary-medium",
    "color.default-medium",
    "color.heading",
    "color.ring",
    "radius.base",
    "radius.default",
    "text.sm"
  ],
  "useWhen": [
    "Confirming the result of an action on the page",
    "Warning about a problem the user should fix before continuing"
  ],
  "avoidWhen": ["Site-wide announcements: use Banner", "Short labels or counts: use Badge"],
  "related": ["Banner", "Badge"],
  "examples": [
    "apps/storybook/registry/demos/alert-demo.tsx",
    "apps/storybook/registry/demos/alert-icon.tsx",
    "apps/storybook/registry/demos/alert-bordered.tsx",
    "apps/storybook/registry/demos/alert-list.tsx",
    "apps/storybook/registry/demos/alert-dismissible.tsx",
    "apps/storybook/registry/demos/alert-accent-border.tsx",
    "apps/storybook/registry/demos/alert-additional-content.tsx",
    "apps/storybook/registry/demos/alert-announcement.tsx"
  ]
}
