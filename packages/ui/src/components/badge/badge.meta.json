{
  "name": "Badge",
  "status": "beta",
  "description": "Use badges to show counts or labels next to other elements, as links, or as removable chips.",
  "category": "data-display",
  "import": "import { Badge } from \"@stefan-florescu/ui\";",
  "ariaPattern": null,
  "client": false,
  "props": "generated",
  "variants": {
    "variant": ["brand", "alternative", "gray", "danger", "success", "warning"],
    "size": ["sm", "lg"],
    "bordered": [true, false],
    "pill": [true, false],
    "iconOnly": [true, false],
    "dot": [true, false]
  },
  "defaults": {
    "variant": "brand",
    "size": "sm"
  },
  "tokens": [
    "color.brand-softer",
    "color.brand-soft",
    "color.brand-subtle",
    "color.fg-brand-strong",
    "color.neutral-primary-soft",
    "color.neutral-secondary-medium",
    "color.neutral-tertiary",
    "color.neutral-tertiary-medium",
    "color.neutral-quaternary",
    "color.heading",
    "color.default",
    "color.default-medium",
    "color.danger-soft",
    "color.danger-medium",
    "color.danger-subtle",
    "color.fg-danger-strong",
    "color.success-soft",
    "color.success-medium",
    "color.success-subtle",
    "color.fg-success-strong",
    "color.warning-soft",
    "color.warning-medium",
    "color.warning-subtle",
    "color.fg-warning",
    "color.ring",
    "radius.default",
    "radius.xs",
    "radius.full",
    "text.xs",
    "text.sm"
  ],
  "useWhen": [
    "Labelling a status, version or category",
    "Showing a count",
    "Showing removable filters (chips)"
  ],
  "avoidWhen": ["Messages that need a sentence: use Alert", "Actions: use Button"],
  "related": ["Alert", "Avatar", "Button"],
  "examples": [
    "apps/storybook/registry/demos/badge-demo.tsx",
    "apps/storybook/registry/demos/badge-bordered.tsx",
    "apps/storybook/registry/demos/badge-large.tsx",
    "apps/storybook/registry/demos/badge-large-bordered.tsx",
    "apps/storybook/registry/demos/badge-pill.tsx",
    "apps/storybook/registry/demos/badge-pill-bordered.tsx",
    "apps/storybook/registry/demos/badge-link.tsx",
    "apps/storybook/registry/demos/badge-icon.tsx",
    "apps/storybook/registry/demos/badge-large-icon.tsx",
    "apps/storybook/registry/demos/badge-icon-only.tsx",
    "apps/storybook/registry/demos/badge-large-icon-only.tsx",
    "apps/storybook/registry/demos/badge-dot.tsx",
    "apps/storybook/registry/demos/badge-loader.tsx",
    "apps/storybook/registry/demos/badge-dismissible.tsx",
    "apps/storybook/registry/demos/badge-avatar.tsx",
    "apps/storybook/registry/demos/badge-notification.tsx",
    "apps/storybook/registry/demos/badge-button.tsx"
  ]
}
