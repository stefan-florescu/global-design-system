{
  "name": "Badge",
  "status": "beta",
  "description": "A small label for a status, count or category. It can also be a link or a removable chip.",
  "category": "data-display",
  "import": "import { Badge } from \"@stefan-florescu/ui\";",
  "ariaPattern": null,
  "client": false,
  "props": "generated",
  "variants": {
    "variant": ["brand", "neutral", "info", "success", "warning", "destructive"],
    "size": ["sm", "lg"],
    "bordered": [true, false],
    "pill": [true, false],
    "iconOnly": [true, false]
  },
  "defaults": { "variant": "brand", "size": "sm" },
  "tokens": [
    "color.brand-subtle",
    "color.brand-subtle-foreground",
    "color.secondary",
    "color.secondary-foreground",
    "color.info-subtle",
    "color.info-subtle-foreground",
    "color.success-subtle",
    "color.success-subtle-foreground",
    "color.warning-subtle",
    "color.warning-subtle-foreground",
    "color.destructive-subtle",
    "color.destructive-subtle-foreground",
    "color.ring",
    "radius.sm",
    "radius.full",
    "text.xs",
    "text.sm"
  ],
  "useWhen": [
    "Labelling a status, version or category",
    "Showing a count",
    "Showing removable filters (chips)"
  ],
  "avoidWhen": ["Messages that need a sentence: use Alert", "Actions: use Button"],
  "related": ["Alert", "Avatar", "Button"],
  "examples": [
    "apps/storybook/registry/demos/badge-demo.tsx",
    "apps/storybook/registry/demos/badge-large.tsx",
    "apps/storybook/registry/demos/badge-bordered.tsx",
    "apps/storybook/registry/demos/badge-pill.tsx",
    "apps/storybook/registry/demos/badge-link.tsx",
    "apps/storybook/registry/demos/badge-icon.tsx",
    "apps/storybook/registry/demos/badge-notification.tsx",
    "apps/storybook/registry/demos/badge-icon-only.tsx",
    "apps/storybook/registry/demos/badge-dismissible.tsx"
  ]
}
