{
  "name": "Select",
  "status": "beta",
  "description": "Flowbite's select: a native select styled as a field, with sizes, list and underline styles.",
  "category": "forms",
  "import": "import { Select } from \"@stefan-florescu/ui\";",
  "ariaPattern": null,
  "client": false,
  "props": "generated",
  "variants": {
    "size": ["sm", "md", "lg", "xl"],
    "variant": ["default", "underline"]
  },
  "tokens": [
    "color.neutral-secondary-medium",
    "color.input",
    "color.heading",
    "color.body",
    "color.brand",
    "color.fg-disabled",
    "color.danger",
    "color.danger-soft",
    "color.fg-danger-strong",
    "color.success",
    "color.success-soft",
    "color.fg-success-strong",
    "radius.base",
    "shadow.xs",
    "color.body-subtle"
  ],
  "useWhen": ["Choosing one option from five or more"],
  "avoidWhen": [],
  "related": ["Label", "HelperText"],
  "docs": "apps/storybook/app/(docs)/forms/select/page.mdx"
}
