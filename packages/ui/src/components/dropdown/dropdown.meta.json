{
  "name": "Dropdown",
  "status": "beta",
  "description": "A dropdown: a button that opens a menu of actions and options (WAI-ARIA menu button, with checkbox, radio and switch items and sub-menus) or a panel of other content (a non-modal dialog or a disclosure), placed on any side of the trigger in the top layer.",
  "category": "navigation",
  "import": "import { Dropdown, DropdownItem, DropdownMenu, DropdownTrigger } from \"@stefan-florescu/ui\";",
  "ariaPattern": "https://www.w3.org/WAI/ARIA/apg/patterns/menu-button/",
  "client": true,
  "props": "generated",
  "parts": [
    "Dropdown",
    "DropdownTrigger",
    "DropdownMenu",
    "DropdownContent",
    "DropdownItem",
    "DropdownCheckboxItem",
    "DropdownRadioGroup",
    "DropdownRadioItem",
    "DropdownSub",
    "DropdownSubTrigger",
    "DropdownSubMenu",
    "DropdownHeader",
    "DropdownGroup",
    "DropdownDivider"
  ],
  "variants": {
    "placement": [
      "top",
      "top-start",
      "top-end",
      "right",
      "right-start",
      "right-end",
      "bottom",
      "bottom-start",
      "bottom-end",
      "left",
      "left-start",
      "left-end"
    ],
    "DropdownItem.variant": ["default", "danger"],
    "DropdownCheckboxItem.indicator": ["checkbox", "toggle"],
    "indicatorPosition": ["start", "end"],
    "DropdownContent.role": ["dialog", null],
    "openOnHover": [true, false]
  },
  "defaults": {
    "placement": "bottom",
    "offset": 10,
    "skidding": 0,
    "openOnHover": false,
    "hoverDelay": 300,
    "DropdownSub.placement": "right-start",
    "DropdownItem.closeOnSelect": true,
    "DropdownCheckboxItem.closeOnSelect": false
  },
  "tokens": [
    "color.neutral-primary-medium",
    "color.neutral-primary-soft",
    "color.neutral-secondary-medium",
    "color.neutral-secondary-strong",
    "color.neutral-tertiary-medium",
    "color.default-medium",
    "color.body",
    "color.heading",
    "color.fg-danger",
    "color.fg-disabled",
    "color.input",
    "color.brand",
    "color.brand-foreground",
    "color.ring",
    "radius.base",
    "radius.default",
    "shadow.lg",
    "z.dropdown"
  ],
  "useWhen": [
    "Offering a list of actions for a button, avatar or icon button",
    "Choosing options that apply at once (checkbox, radio or switch items)",
    "Showing a small panel of controls, such as a search with a filtered list or a date range, next to its button",
    "A second level of links in a navigation bar (DropdownContent without a role)"
  ],
  "avoidWhen": [
    "Choosing a value for a form field: use Select",
    "More than one level of nested choices: use a dialog or a separate page",
    "Content users must read before continuing: use a modal dialog"
  ],
  "related": ["Button", "Avatar", "Checkbox", "Radio", "Toggle", "Datepicker"],
  "examples": [
    "apps/storybook/registry/demos/dropdown-demo.tsx",
    "apps/storybook/registry/demos/dropdown-hover.tsx",
    "apps/storybook/registry/demos/dropdown-hover-delay.tsx",
    "apps/storybook/registry/demos/dropdown-divider.tsx",
    "apps/storybook/registry/demos/dropdown-header.tsx",
    "apps/storybook/registry/demos/dropdown-multi-level.tsx",
    "apps/storybook/registry/demos/dropdown-checkbox.tsx",
    "apps/storybook/registry/demos/dropdown-checkbox-hover.tsx",
    "apps/storybook/registry/demos/dropdown-checkbox-helper.tsx",
    "apps/storybook/registry/demos/dropdown-radio.tsx",
    "apps/storybook/registry/demos/dropdown-radio-hover.tsx",
    "apps/storybook/registry/demos/dropdown-radio-helper.tsx",
    "apps/storybook/registry/demos/dropdown-toggle.tsx",
    "apps/storybook/registry/demos/dropdown-scrolling.tsx",
    "apps/storybook/registry/demos/dropdown-scrollable-checkboxes.tsx",
    "apps/storybook/registry/demos/dropdown-search.tsx",
    "apps/storybook/registry/demos/dropdown-menu-icon.tsx",
    "apps/storybook/registry/demos/dropdown-notification.tsx",
    "apps/storybook/registry/demos/dropdown-avatar.tsx",
    "apps/storybook/registry/demos/dropdown-avatar-name.tsx",
    "apps/storybook/registry/demos/dropdown-navbar.tsx",
    "apps/storybook/registry/demos/dropdown-datepicker.tsx",
    "apps/storybook/registry/demos/dropdown-sizes.tsx",
    "apps/storybook/registry/demos/dropdown-placement.tsx",
    "apps/storybook/registry/demos/dropdown-double-placement.tsx",
    "apps/storybook/registry/demos/dropdown-offset-distance.tsx",
    "apps/storybook/registry/demos/dropdown-offset-skidding.tsx"
  ]
}
