{
  "name": "Button",
  "status": "beta",
  "description": "Triggers an action or event, such as submitting a form, opening a dialog or confirming a change.",
  "category": "actions",
  "import": "import { Button } from \"@stefan-florescu/ui\";",
  "ariaPattern": "https://www.w3.org/WAI/ARIA/apg/patterns/button/",
  "props": "generated",
  "variants": {
    "variant": ["brand", "secondary", "tertiary", "success", "danger", "warning", "dark", "ghost"],
    "outline": [true, false],
    "size": ["xs", "sm", "md", "lg", "xl"],
    "pill": [true, false],
    "iconOnly": [true, false],
    "fullWidth": [true, false]
  },
  "defaults": {
    "variant": "brand",
    "size": "md",
    "type": "button"
  },
  "tokens": [
    "color.brand",
    "color.brand-strong",
    "color.brand-medium",
    "color.brand-subtle",
    "color.brand-foreground",
    "color.fg-brand",
    "color.neutral-primary",
    "color.neutral-primary-soft",
    "color.neutral-secondary-medium",
    "color.neutral-secondary-soft",
    "color.neutral-tertiary",
    "color.neutral-tertiary-medium",
    "color.neutral-tertiary-soft",
    "color.default",
    "color.default-medium",
    "color.body",
    "color.heading",
    "color.success",
    "color.success-strong",
    "color.success-medium",
    "color.success-foreground",
    "color.fg-success",
    "color.danger",
    "color.danger-strong",
    "color.danger-medium",
    "color.danger-foreground",
    "color.fg-danger",
    "color.warning",
    "color.warning-strong",
    "color.warning-medium",
    "color.warning-foreground",
    "color.fg-warning",
    "color.dark",
    "color.dark-strong",
    "color.dark-foreground",
    "color.disabled",
    "color.fg-disabled",
    "color.ring",
    "radius.base",
    "shadow.xs"
  ],
  "useWhen": [
    "Submitting a form or confirming a dialog",
    "Starting an action on the current page",
    "Offering a primary call to action, with one brand button per view"
  ],
  "avoidWhen": [
    "Navigating to another page: use a link, styled with buttonVariants() if it must look like a button",
    "Toggling a setting on and off: use a switch or checkbox"
  ],
  "related": [],
  "examples": [
    "apps/storybook/registry/demos/button-demo.tsx",
    "apps/storybook/registry/demos/button-variants.tsx",
    "apps/storybook/registry/demos/button-pill.tsx",
    "apps/storybook/registry/demos/button-outline.tsx",
    "apps/storybook/registry/demos/button-sizes.tsx",
    "apps/storybook/registry/demos/button-sizes-with-icon.tsx",
    "apps/storybook/registry/demos/button-with-icon.tsx",
    "apps/storybook/registry/demos/button-with-label.tsx",
    "apps/storybook/registry/demos/button-icon.tsx",
    "apps/storybook/registry/demos/button-loading.tsx",
    "apps/storybook/registry/demos/button-disabled.tsx",
    "apps/storybook/registry/demos/button-full-width.tsx",
    "apps/storybook/registry/demos/button-as-link.tsx"
  ]
}
