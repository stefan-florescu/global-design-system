    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@stefan-florescu/eslint-config": "workspace:*",
    "@stefan-florescu/tailwind-config": "workspace:*",
    "@stefan-florescu/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
